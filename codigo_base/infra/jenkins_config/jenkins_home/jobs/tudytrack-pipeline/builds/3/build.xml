  <execution class="org.jenkinsci.plugins.workflow.cps.CpsFlowExecution">
    <result>SUCCESS</result>
    <script>pipeline {
    agent any

    environment {
        REGISTRY    = &apos;localhost:9080&apos;          // registry visto por el Docker del host
        NEXUS_URL   = &apos;http://nexus:8081&apos;       // Nexus visto desde cicd_network
        NEXUS_CREDS = credentials(&apos;nexus-credentials&apos;)
    }

    triggers {
        githubPush()
    }

    stages {
        stage(&apos;Checkout &amp; Test&apos;) {
            steps {
                checkout scm
                script {
                    def sha = sh(script: &apos;git rev-parse --short=7 HEAD&apos;, returnStdout: true).trim()
                    env.VERSION = &quot;1.0.${env.BUILD_NUMBER}-${sha}&quot;
                    echo &quot;Versión inmutable: ${env.VERSION}&quot;
                }
                dir(&apos;codigo_base/backend&apos;) {
                    sh &apos;mvn -B test&apos;
                }
            }
            post {
                always {
                    junit &apos;codigo_base/backend/target/surefire-reports/*.xml&apos;
                }
            }
        }

        stage(&apos;Package &amp; Tag Inmutable&apos;) {
            steps {
                dir(&apos;codigo_base/backend&apos;) {
                    sh &apos;mvn -B package -DskipTests -Drevision=$VERSION&apos;
                    sh &apos;docker build -t $REGISTRY/studytrack-api:$VERSION .&apos;
                }
                dir(&apos;codigo_base/frontend&apos;) {
                    sh &apos;docker build --build-arg VITE_API_URL=http://localhost:8080 -t $REGISTRY/studytrack-frontend:$VERSION .&apos;
                }
            }
        }

        stage(&apos;Publish to Nexus&apos;) {
            steps {
                writeFile file: &apos;ci-settings.xml&apos;, text: &apos;&apos;&apos;&lt;settings&gt;
  &lt;servers&gt;
    &lt;server&gt;
      &lt;id&gt;nexus-releases&lt;/id&gt;
      &lt;username&gt;${env.NEXUS_CREDS_USR}&lt;/username&gt;
      &lt;password&gt;${env.NEXUS_CREDS_PSW}&lt;/password&gt;
    &lt;/server&gt;
  &lt;/servers&gt;
&lt;/settings&gt;&apos;&apos;&apos;
                dir(&apos;codigo_base/backend&apos;) {
                    sh &apos;mvn -B deploy -DskipTests -Drevision=$VERSION -Dnexus.url=$NEXUS_URL -s ../../ci-settings.xml&apos;
                }
                sh &apos;&apos;&apos;
                    echo &quot;$NEXUS_CREDS_PSW&quot; | docker login $REGISTRY -u &quot;$NEXUS_CREDS_USR&quot; --password-stdin
                    docker push $REGISTRY/studytrack-api:$VERSION
                    docker push $REGISTRY/studytrack-frontend:$VERSION
                &apos;&apos;&apos;
            }
        }

        stage(&apos;Deploy &amp; Smoke Test&apos;) {
            steps {
                sh &apos;IMAGE_TAG=$VERSION docker compose -f codigo_base/deploy/docker-compose.yml up -d&apos;
                sh &apos;&apos;&apos;
                    for i in $(seq 1 20); do
                        if curl -fs http://studytrack-api:8080/api/tasks; then
                            echo &quot;Smoke test OK&quot;; exit 0
                        fi
                        echo &quot;Intento $i fallido, reintentando en 5s...&quot;; sleep 5
                    done
                    echo &quot;Smoke test FALLÓ&quot;; exit 1
                &apos;&apos;&apos;
            }
        }
    }
}</script>
